{
  "manifest_version": 3,
  "name": "Parking Layout Planner (Experimental)",
  "version": "0.2.0",
  "description": "Generate local parking-layout overlays for drawn Google Maps areas or the parcel selected on TKGM Parsel Sorgu. Bilingual (EN/TR).",
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://www.google.com/maps",
        "https://maps.google.com/*"
      ],
      "js": ["layout.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://parselsorgu.tkgm.gov.tr/*"],
      "js": ["tkgm-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://parselsorgu.tkgm.gov.tr/*"],
      "js": ["tkgm-geometry.js", "layout.js", "tkgm-content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
